<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="stakhal-dark" _name="StakHAL Dark+" version="1.0">
  <author>StakHAL Team</author>
  <_description>VS Code Dark+ inspired theme palette for StakHAL</_description>

  <!-- Palette definitions -->
  <color name="background" value="#0a0a0a"/>
  <color name="foreground" value="#e5e5e5"/>
  <color name="keyword" value="#ffffff"/>
  <color name="type" value="#d4d4d4"/>
  <color name="string" value="#a3a3a3"/>
  <color name="comment" value="#666666"/>
  <color name="number" value="#a3a3a3"/>
  <color name="preprocessor" value="#d4d4d4"/>
  <color name="function" value="#ffffff"/>
  <color name="current-line" value="#141414"/>
  <color name="selection" value="#262626"/>
  <color name="line-numbers" value="#525252"/>

  <!-- Global Settings -->
  <style name="text" foreground="foreground" background="background"/>
  <style name="selection" background="selection"/>
  <style name="current-line" background="current-line"/>
  <style name="line-numbers" foreground="line-numbers" background="background"/>

  <!-- Language Highlighting Styles -->
  <style name="c:keyword" foreground="keyword" bold="true"/>
  <style name="def:keyword" foreground="keyword" bold="true"/>
  <style name="def:type" foreground="type"/>
  <style name="def:string" foreground="string"/>
  <style name="def:comment" foreground="comment" italic="true"/>
  <style name="def:number" foreground="number"/>
  <style name="def:decimal" foreground="number"/>
  <style name="def:base-n" foreground="number"/>
  <style name="def:floating-point" foreground="number"/>
  <style name="def:preprocessor" foreground="preprocessor"/>
  <style name="def:identifier" foreground="foreground"/>
  <style name="def:function" foreground="function"/>
  <style name="def:statement" foreground="keyword" bold="true"/>
  <style name="def:constant" foreground="number"/>

</style-scheme>
