import { Button, LineEdit, ScrollView } from "std-widgets.slint";

export struct PeripheralItem {
    name: string,
    mode: string,
    param_count: string,
}

export struct RegionItem {
    tag: string,
    byte_range: string,
    line_range: string,
    is_implicit: bool,
}

export struct PvItem {
    name: string,
    type_str: string,
    initial_value: string,
    raw_text: string,
    line: int,
    pv_index: int,
    is_expanded: bool,
    has_error: bool,
    error_message: string,
}

export component MainWindow inherits Window {
    title: "StakHAL - STM32 Project Viewer";
    preferred-width: 1050px;
    preferred-height: 650px;
    background: #121212;

    in-out property <string> project_dir: "";
    in property <string> discovered_ioc_path: "";
    in property <string> discovered_main_c_path: "";
    in property <bool> has_discovered_paths: false;

    in property <string> mcu_family: "";
    in property <string> mcu_name: "";
    in property <string> project_name: "";
    in property <bool> project_loaded: false;

    in property <bool> has_error: false;
    in property <string> error_message: "";

    in property <[PeripheralItem]> peripherals: [];
    in property <[RegionItem]> regions: [];
    in property <[PvItem]> pv_variables: [];

    callback load_clicked();
    callback browse_folder_clicked();

    callback toggle_pv_expanded(int);
    callback save_pv_inline_edit(int, string);
    callback cancel_pv_inline_edit(int);

    VerticalLayout {
        padding: 16px;
        spacing: 12px;

        // Top Control Panel (Folder Selection, Discovered Paths, & Load Button)
        Rectangle {
            background: #1e1e1e;
            border-radius: 8px;
            border-width: 1px;
            border-color: #333333;

            VerticalLayout {
                padding: 12px;
                spacing: 10px;

                HorizontalLayout {
                    Text {
                        text: "Project Directory Configuration";
                        font-size: 14px;
                        font-weight: 700;
                        color: #eeeeee;
                    }
                }

                HorizontalLayout {
                    spacing: 12px;

                    VerticalLayout {
                        alignment: center;

                        Button {
                            text: "Browse Project Folder";
                            clicked => { root.browse_folder_clicked(); }
                        }
                    }

                    VerticalLayout {
                        spacing: 4px;
                        horizontal-stretch: 1;

                        HorizontalLayout {
                            spacing: 6px;
                            Text {
                                text: ".ioc Path:";
                                font-size: 11px;
                                font-weight: 700;
                                color: #aaaaaa;
                            }
                            Text {
                                text: root.has_discovered_paths ? root.discovered_ioc_path : "(no .ioc file discovered)";
                                font-size: 11px;
                                color: root.has_discovered_paths ? #888888 : #666666;
                                overflow: elide;
                            }
                        }

                        HorizontalLayout {
                            spacing: 6px;
                            Text {
                                text: "main.c Path:";
                                font-size: 11px;
                                font-weight: 700;
                                color: #aaaaaa;
                            }
                            Text {
                                text: root.has_discovered_paths ? root.discovered_main_c_path : "(no main.c file discovered)";
                                font-size: 11px;
                                color: root.has_discovered_paths ? #888888 : #666666;
                                overflow: elide;
                            }
                        }
                    }

                    VerticalLayout {
                        alignment: center;

                        Button {
                            text: "Load Project";
                            primary: true;
                            enabled: root.has_discovered_paths;
                            clicked => { root.load_clicked(); }
                        }
                    }
                }
            }
        }

        // Global Semantic Error Banner (Red)
        if root.has_error : Rectangle {
            background: #2c1616;
            border-radius: 6px;
            border-width: 1px;
            border-color: #8b2626;

            HorizontalLayout {
                padding: 10px;
                spacing: 10px;

                Text {
                    text: "Error:";
                    font-size: 13px;
                    font-weight: 700;
                    color: #f87171;
                }

                Text {
                    text: root.error_message;
                    font-size: 12px;
                    color: #f87171;
                    wrap: word-wrap;
                    horizontal-stretch: 1;
                }
            }
        }

        // Header Info Area (Semantic Green accent when project is loaded)
        Rectangle {
            background: #1e1e1e;
            border-radius: 6px;
            border-width: 1px;
            border-color: root.project_loaded ? #2e7d32 : #333333;

            HorizontalLayout {
                padding: 12px;
                spacing: 24px;

                HorizontalLayout {
                    spacing: 6px;
                    Text { text: "Project:"; font-size: 13px; font-weight: 700; color: root.project_loaded ? #81c784 : #aaaaaa; }
                    Text { text: root.project_loaded ? root.project_name : "—"; font-size: 13px; color: #eeeeee; }
                }

                HorizontalLayout {
                    spacing: 6px;
                    Text { text: "MCU Family:"; font-size: 13px; font-weight: 700; color: root.project_loaded ? #81c784 : #aaaaaa; }
                    Text { text: root.project_loaded ? root.mcu_family : "—"; font-size: 13px; color: #eeeeee; }
                }

                HorizontalLayout {
                    spacing: 6px;
                    Text { text: "MCU Name:"; font-size: 13px; font-weight: 700; color: root.project_loaded ? #81c784 : #aaaaaa; }
                    Text { text: root.project_loaded ? root.mcu_name : "—"; font-size: 13px; color: #eeeeee; }
                }
            }
        }

        // Content Area (Peripherals, User Regions, & PV Variables Accordion)
        HorizontalLayout {
            spacing: 12px;
            vertical-stretch: 1;

            // Section 1: Peripherals
            Rectangle {
                background: #181818;
                border-radius: 8px;
                border-width: 1px;
                border-color: #333333;
                horizontal-stretch: 1;

                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;

                    Text {
                        text: "Peripherals (" + root.peripherals.length + ")";
                        font-size: 14px;
                        font-weight: 700;
                        color: #eeeeee;
                    }

                    Rectangle {
                        height: 1px;
                        background: #333333;
                    }

                    ScrollView {
                        VerticalLayout {
                            alignment: start;
                            spacing: 4px;

                            if root.peripherals.length == 0 : Text {
                                text: root.project_loaded ? "No peripherals configured." : "Select folder and click Load Project.";
                                font-size: 12px;
                                color: #777777;
                            }

                            for item in root.peripherals : Rectangle {
                                background: #222222;
                                border-radius: 4px;
                                height: 36px;

                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;

                                    Text {
                                        text: item.name;
                                        font-size: 12px;
                                        font-weight: 700;
                                        color: #eeeeee;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                    }

                                    Text {
                                        text: "Mode: " + item.mode;
                                        font-size: 11px;
                                        color: #cccccc;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                    }

                                    Text {
                                        text: "Params: " + item.param_count;
                                        font-size: 11px;
                                        color: #aaaaaa;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // Section 2: User Regions
            Rectangle {
                background: #181818;
                border-radius: 8px;
                border-width: 1px;
                border-color: #333333;
                horizontal-stretch: 1;

                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;

                    Text {
                        text: "User Regions (" + root.regions.length + ")";
                        font-size: 14px;
                        font-weight: 700;
                        color: #eeeeee;
                    }

                    Rectangle {
                        height: 1px;
                        background: #333333;
                    }

                    ScrollView {
                        VerticalLayout {
                            alignment: start;
                            spacing: 4px;

                            if root.regions.length == 0 : Text {
                                text: root.project_loaded ? "No user regions found." : "Select folder and click Load Project.";
                                font-size: 12px;
                                color: #777777;
                            }

                            for item in root.regions : Rectangle {
                                background: item.is_implicit ? #2e2912 : #222222;
                                border-color: item.is_implicit ? #856404 : #333333;
                                border-width: 1px;
                                border-radius: 4px;
                                height: 38px;

                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    spacing: 8px;

                                    HorizontalLayout {
                                        spacing: 6px;
                                        width: 150px;

                                        Text {
                                            text: item.tag;
                                            font-size: 12px;
                                            font-weight: 700;
                                            color: item.is_implicit ? #fbbf24 : #eeeeee;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }

                                        if item.is_implicit : Rectangle {
                                            background: #f59e0b;
                                            border-radius: 3px;
                                            width: 55px;
                                            height: 16px;

                                            Text {
                                                text: "[implicit]";
                                                font-size: 9px;
                                                font-weight: 700;
                                                color: #121212;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }

                                    Text {
                                        text: "Bytes: " + item.byte_range;
                                        font-size: 11px;
                                        color: item.is_implicit ? #e5c07b : #cccccc;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                    }

                                    Text {
                                        text: "Lines: " + item.line_range;
                                        font-size: 11px;
                                        color: item.is_implicit ? #e5c07b : #aaaaaa;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // Section 3: PV Variables Panel (Inline Accordion Editing)
            Rectangle {
                background: #181818;
                border-radius: 8px;
                border-width: 1px;
                border-color: #333333;
                horizontal-stretch: 1.2;

                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;

                    Text {
                        text: "PV Variables (" + root.pv_variables.length + ")";
                        font-size: 14px;
                        font-weight: 700;
                        color: #eeeeee;
                    }

                    Rectangle {
                        height: 1px;
                        background: #333333;
                    }

                    ScrollView {
                        VerticalLayout {
                            alignment: start;
                            spacing: 6px;

                            if root.pv_variables.length == 0 : Text {
                                text: root.project_loaded ? "No PV declarations found." : "Select folder and click Load Project.";
                                font-size: 12px;
                                color: #777777;
                            }

                            for item in root.pv_variables : Rectangle {
                                background: item.is_expanded ? #25282a : #222222;
                                border-radius: 6px;
                                border-color: item.is_expanded ? #3b82f6 : #333333;
                                border-width: 1px;

                                VerticalLayout {
                                    padding: 8px;
                                    spacing: 8px;

                                    // Collapsed Header Row (Whole row is clickable to toggle expansion)
                                    TouchArea {
                                        clicked => { root.toggle_pv_expanded(item.pv_index); }

                                        HorizontalLayout {
                                            spacing: 8px;

                                            Text {
                                                text: (item.is_expanded ? "▼ " : "► ") + item.name;
                                                font-size: 12px;
                                                font-weight: 700;
                                                color: item.is_expanded ? #60a5fa : #eeeeee;
                                                vertical-alignment: center;
                                                width: 110px;
                                                overflow: elide;
                                            }

                                            Text {
                                                text: item.type_str;
                                                font-size: 11px;
                                                color: #cccccc;
                                                vertical-alignment: center;
                                                width: 105px;
                                                overflow: elide;
                                            }

                                            Text {
                                                text: "Init: " + item.initial_value;
                                                font-size: 11px;
                                                color: #aaaaaa;
                                                vertical-alignment: center;
                                                horizontal-stretch: 1;
                                                overflow: elide;
                                            }

                                            Text {
                                                text: "L" + item.line;
                                                font-size: 11px;
                                                color: #777777;
                                                vertical-alignment: center;
                                                width: 35px;
                                            }
                                        }
                                    }

                                    // Inline Expanded Editor Body
                                    if item.is_expanded : VerticalLayout {
                                        spacing: 8px;

                                        if item.has_error : Rectangle {
                                            background: #3b1818;
                                            border-radius: 4px;
                                            border-width: 1px;
                                            border-color: #991b1b;

                                            HorizontalLayout {
                                                padding: 6px;
                                                spacing: 6px;

                                                Text {
                                                    text: "Error:";
                                                    font-size: 11px;
                                                    font-weight: 700;
                                                    color: #f87171;
                                                }

                                                Text {
                                                    text: item.error_message;
                                                    font-size: 11px;
                                                    color: #f87171;
                                                    wrap: word-wrap;
                                                    horizontal-stretch: 1;
                                                }
                                            }
                                        }

                                        Text {
                                            text: "Edit Declaration Statement:";
                                            font-size: 11px;
                                            font-weight: 700;
                                            color: #aaaaaa;
                                        }

                                        edit_box := LineEdit {
                                            text: item.raw_text;
                                            font-size: 12px;
                                        }

                                        HorizontalLayout {
                                            spacing: 8px;
                                            alignment: end;

                                            Button {
                                                text: "Cancel";
                                                clicked => { root.cancel_pv_inline_edit(item.pv_index); }
                                            }

                                            Button {
                                                text: "Save";
                                                primary: true;
                                                clicked => { root.save_pv_inline_edit(item.pv_index, edit_box.text); }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
