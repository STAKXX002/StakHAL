import { Button, LineEdit, ListView, ScrollView } from "std-widgets.slint";

export struct PeripheralItem {
    name: string,
    mode: string,
    param_count: string,
}

export struct RegionItem {
    tag: string,
    byte_range: string,
    line_range: string,
    is_implicit: bool,
}

export struct PvItem {
    name: string,
    type_str: string,
    initial_value: string,
    raw_text: string,
    line: int,
    pv_index: int,
}

export struct SourceLineItem {
    line_number: int,
    text: string,
    tier_str: string, // "generated", "normal", "declaration", "usage"
    is_editing: bool,
    has_error: bool,
    error_message: string,
}

export component MainWindow inherits Window {
    title: "StakHAL - STM32 Project Viewer";
    preferred-width: 1150px;
    preferred-height: 720px;
    background: #121212;

    in-out property <string> project_dir: "";
    in property <string> discovered_ioc_path: "";
    in property <string> discovered_main_c_path: "";
    in property <bool> has_discovered_paths: false;

    in property <string> mcu_family: "";
    in property <string> mcu_name: "";
    in property <string> project_name: "";
    in property <bool> project_loaded: false;

    in property <bool> has_error: false;
    in property <string> error_message: "";

    in property <[PeripheralItem]> peripherals: [];
    in property <[RegionItem]> regions: [];
    in property <[PvItem]> pv_variables: [];

    // Source Sub-Panel Properties
    in property <bool> showing_source_view: false;
    in property <string> active_pv_name: "";
    in property <string> active_pv_type: "";
    in property <[SourceLineItem]> source_lines: [];
    in property <int> total_line_count: 0;
    in property <int> visible_start_index: 0;
    in-out property <length> source_scroll_y: 0px;

    animate source_scroll_y {
        duration: 250ms;
        easing: ease-out;
    }

    changed source_scroll_y => {
        root.source_scroll_changed(root.source_scroll_y);
    }


    callback load_clicked();
    callback browse_folder_clicked();

    callback open_pv_source_view(int);
    callback close_pv_source_view();
    callback click_declaration_line(int);
    callback cancel_declaration_edit(int);
    callback save_declaration_edit(int, string);
    callback source_scroll_changed(length);
    callback jump_to_line(int);

    VerticalLayout {
        padding: 16px;
        spacing: 12px;

        // Top Control Panel (Folder Selection, Discovered Paths, & Load Button)
        Rectangle {
            background: #1e1e1e;
            border-radius: 8px;
            border-width: 1px;
            border-color: #333333;

            VerticalLayout {
                padding: 12px;
                spacing: 10px;

                HorizontalLayout {
                    Text {
                        text: "Project Directory Configuration";
                        font-size: 14px;
                        font-weight: 700;
                        color: #eeeeee;
                    }
                }

                HorizontalLayout {
                    spacing: 12px;

                    VerticalLayout {
                        alignment: center;

                        Button {
                            text: "Browse Project Folder";
                            clicked => { root.browse_folder_clicked(); }
                        }
                    }

                    VerticalLayout {
                        spacing: 4px;
                        horizontal-stretch: 1;

                        HorizontalLayout {
                            spacing: 6px;
                            Text {
                                text: ".ioc Path:";
                                font-size: 11px;
                                font-weight: 700;
                                color: #aaaaaa;
                            }
                            Text {
                                text: root.has_discovered_paths ? root.discovered_ioc_path : "(no .ioc file discovered)";
                                font-size: 11px;
                                color: root.has_discovered_paths ? #888888 : #666666;
                                overflow: elide;
                            }
                        }

                        HorizontalLayout {
                            spacing: 6px;
                            Text {
                                text: "main.c Path:";
                                font-size: 11px;
                                font-weight: 700;
                                color: #aaaaaa;
                            }
                            Text {
                                text: root.has_discovered_paths ? root.discovered_main_c_path : "(no main.c file discovered)";
                                font-size: 11px;
                                color: root.has_discovered_paths ? #888888 : #666666;
                                overflow: elide;
                            }
                        }
                    }

                    VerticalLayout {
                        alignment: center;

                        Button {
                            text: "Load Project";
                            primary: true;
                            enabled: root.has_discovered_paths;
                            clicked => { root.load_clicked(); }
                        }
                    }
                }
            }
        }

        // Global Semantic Error Banner (Red)
        if root.has_error : Rectangle {
            background: #2c1616;
            border-radius: 6px;
            border-width: 1px;
            border-color: #8b2626;

            HorizontalLayout {
                padding: 10px;
                spacing: 10px;

                Text {
                    text: "Error:";
                    font-size: 13px;
                    font-weight: 700;
                    color: #f87171;
                }

                Text {
                    text: root.error_message;
                    font-size: 12px;
                    color: #f87171;
                    wrap: word-wrap;
                    horizontal-stretch: 1;
                }
            }
        }

        // Header Info Area (Semantic Green accent when project is loaded)
        Rectangle {
            background: #1e1e1e;
            border-radius: 6px;
            border-width: 1px;
            border-color: root.project_loaded ? #2e7d32 : #333333;

            HorizontalLayout {
                padding: 12px;
                spacing: 24px;

                HorizontalLayout {
                    spacing: 6px;
                    Text { text: "Project:"; font-size: 13px; font-weight: 700; color: root.project_loaded ? #81c784 : #aaaaaa; }
                    Text { text: root.project_loaded ? root.project_name : "—"; font-size: 13px; color: #eeeeee; }
                }

                HorizontalLayout {
                    spacing: 6px;
                    Text { text: "MCU Family:"; font-size: 13px; font-weight: 700; color: root.project_loaded ? #81c784 : #aaaaaa; }
                    Text { text: root.project_loaded ? root.mcu_family : "—"; font-size: 13px; color: #eeeeee; }
                }

                HorizontalLayout {
                    spacing: 6px;
                    Text { text: "MCU Name:"; font-size: 13px; font-weight: 700; color: root.project_loaded ? #81c784 : #aaaaaa; }
                    Text { text: root.project_loaded ? root.mcu_name : "—"; font-size: 13px; color: #eeeeee; }
                }
            }
        }

        // Main Content View Mode Switch
        if !root.showing_source_view : HorizontalLayout {
            spacing: 12px;
            vertical-stretch: 1;

            // Section 1: Peripherals
            Rectangle {
                background: #181818;
                border-radius: 8px;
                border-width: 1px;
                border-color: #333333;
                horizontal-stretch: 1;

                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;

                    Text {
                        text: "Peripherals (" + root.peripherals.length + ")";
                        font-size: 14px;
                        font-weight: 700;
                        color: #eeeeee;
                    }

                    Rectangle {
                        height: 1px;
                        background: #333333;
                    }

                    ScrollView {
                        VerticalLayout {
                            alignment: start;
                            spacing: 4px;

                            if root.peripherals.length == 0 : Text {
                                text: root.project_loaded ? "No peripherals configured." : "Select folder and click Load Project.";
                                font-size: 12px;
                                color: #777777;
                            }

                            for item in root.peripherals : Rectangle {
                                background: #222222;
                                border-radius: 4px;
                                height: 36px;

                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;

                                    Text {
                                        text: item.name;
                                        font-size: 12px;
                                        font-weight: 700;
                                        color: #eeeeee;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                    }

                                    Text {
                                        text: "Mode: " + item.mode;
                                        font-size: 11px;
                                        color: #cccccc;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                    }

                                    Text {
                                        text: "Params: " + item.param_count;
                                        font-size: 11px;
                                        color: #aaaaaa;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // Section 2: User Regions
            Rectangle {
                background: #181818;
                border-radius: 8px;
                border-width: 1px;
                border-color: #333333;
                horizontal-stretch: 1;

                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;

                    Text {
                        text: "User Regions (" + root.regions.length + ")";
                        font-size: 14px;
                        font-weight: 700;
                        color: #eeeeee;
                    }

                    Rectangle {
                        height: 1px;
                        background: #333333;
                    }

                    ScrollView {
                        VerticalLayout {
                            alignment: start;
                            spacing: 4px;

                            if root.regions.length == 0 : Text {
                                text: root.project_loaded ? "No user regions found." : "Select folder and click Load Project.";
                                font-size: 12px;
                                color: #777777;
                            }

                            for item in root.regions : Rectangle {
                                background: item.is_implicit ? #2e2912 : #222222;
                                border-color: item.is_implicit ? #856404 : #333333;
                                border-width: 1px;
                                border-radius: 4px;
                                height: 38px;

                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    spacing: 8px;

                                    HorizontalLayout {
                                        spacing: 6px;
                                        width: 150px;

                                        Text {
                                            text: item.tag;
                                            font-size: 12px;
                                            font-weight: 700;
                                            color: item.is_implicit ? #fbbf24 : #eeeeee;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }

                                        if item.is_implicit : Rectangle {
                                            background: #f59e0b;
                                            border-radius: 3px;
                                            width: 55px;
                                            height: 16px;

                                            Text {
                                                text: "[implicit]";
                                                font-size: 9px;
                                                font-weight: 700;
                                                color: #121212;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }

                                    Text {
                                        text: "Bytes: " + item.byte_range;
                                        font-size: 11px;
                                        color: item.is_implicit ? #e5c07b : #cccccc;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                    }

                                    Text {
                                        text: "Lines: " + item.line_range;
                                        font-size: 11px;
                                        color: item.is_implicit ? #e5c07b : #aaaaaa;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // Section 3: PV Variables Panel (Click row to open Source Sub-Panel)
            Rectangle {
                background: #181818;
                border-radius: 8px;
                border-width: 1px;
                border-color: #333333;
                horizontal-stretch: 1.2;

                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;

                    Text {
                        text: "PV Variables (" + root.pv_variables.length + ")";
                        font-size: 14px;
                        font-weight: 700;
                        color: #eeeeee;
                    }

                    Rectangle {
                        height: 1px;
                        background: #333333;
                    }

                    ScrollView {
                        VerticalLayout {
                            alignment: start;
                            spacing: 6px;

                            if root.pv_variables.length == 0 : Text {
                                text: root.project_loaded ? "No PV declarations found." : "Select folder and click Load Project.";
                                font-size: 12px;
                                color: #777777;
                            }

                            for item in root.pv_variables : Rectangle {
                                background: #222222;
                                border-radius: 6px;
                                border-color: #333333;
                                border-width: 1px;
                                height: 42px;

                                TouchArea {
                                    clicked => { root.open_pv_source_view(item.pv_index); }

                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 10px;
                                        spacing: 8px;

                                        Text {
                                            text: item.name;
                                            font-size: 12px;
                                            font-weight: 700;
                                            color: #60a5fa;
                                            vertical-alignment: center;
                                            width: 110px;
                                            overflow: elide;
                                        }

                                        Text {
                                            text: item.type_str;
                                            font-size: 11px;
                                            color: #cccccc;
                                            vertical-alignment: center;
                                            width: 105px;
                                            overflow: elide;
                                        }

                                        Text {
                                            text: "Init: " + item.initial_value;
                                            font-size: 11px;
                                            color: #aaaaaa;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                            overflow: elide;
                                        }

                                        Text {
                                            text: "L" + item.line;
                                            font-size: 11px;
                                            color: #777777;
                                            vertical-alignment: center;
                                            width: 35px;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // FULL SOURCE SUB-PANEL (Replaces main content view when showing_source_view is true)
        if root.showing_source_view : Rectangle {
            background: #111111;
            border-radius: 8px;
            border-width: 1px;
            border-color: #3b82f6;
            vertical-stretch: 1;

            VerticalLayout {
                padding: 12px;
                spacing: 10px;

                // Source View Header (Variable details + Quiet Legend + Close button)
                HorizontalLayout {
                    spacing: 16px;

                    HorizontalLayout {
                        spacing: 8px;

                        Text {
                            text: "PV Source View:";
                            font-size: 14px;
                            font-weight: 700;
                            color: #81c784;
                            vertical-alignment: center;
                        }

                        Text {
                            text: root.active_pv_name;
                            font-size: 14px;
                            font-weight: 700;
                            color: #60a5fa;
                            vertical-alignment: center;
                        }

                        Text {
                            text: "(" + root.active_pv_type + ")";
                            font-size: 13px;
                            color: #cccccc;
                            vertical-alignment: center;
                        }
                    }

                    // Compact Quiet Legend (Non-interactive dot swatches + labels)
                    HorizontalLayout {
                        spacing: 16px;
                        horizontal-stretch: 1;

                        HorizontalLayout {
                            spacing: 5px;

                            Text {
                                text: "●";
                                font-size: 10px;
                                color: #34d399;
                                vertical-alignment: center;
                            }

                            Text {
                                text: "Declaration";
                                font-size: 11px;
                                color: #a7f3d0;
                                vertical-alignment: center;
                            }
                        }

                        HorizontalLayout {
                            spacing: 5px;

                            Text {
                                text: "●";
                                font-size: 10px;
                                color: #38bdf8;
                                vertical-alignment: center;
                            }

                            Text {
                                text: "Usage";
                                font-size: 11px;
                                color: #38bdf8;
                                vertical-alignment: center;
                            }
                        }

                        HorizontalLayout {
                            spacing: 5px;

                            Text {
                                text: "●";
                                font-size: 10px;
                                color: #d1d5db;
                                vertical-alignment: center;
                            }

                            Text {
                                text: "User Code";
                                font-size: 11px;
                                color: #d1d5db;
                                vertical-alignment: center;
                            }
                        }

                        HorizontalLayout {
                            spacing: 5px;

                            Text {
                                text: "●";
                                font-size: 10px;
                                color: #555555;
                                vertical-alignment: center;
                            }

                            Text {
                                text: "Generated";
                                font-size: 11px;
                                color: #555555;
                                vertical-alignment: center;
                            }
                        }
                    }

                    Button {
                        text: "Close";
                        clicked => { root.close_pv_source_view(); }
                    }
                }

                Rectangle {
                    height: 1px;
                    background: #2a2a2a;
                }

                // Scrollable Code View with Windowing Virtualization (Top Spacer + Rows + Bottom Spacer)
                ScrollView {
                    viewport-y <=> root.source_scroll_y;

                    VerticalLayout {
                        alignment: start;
                        spacing: 0px;

                        // Top Spacer
                        Rectangle {
                            height: root.visible_start_index * 20px;
                        }

                        // Visible Window Rows
                        for item in root.source_lines : Rectangle {
                            height: 20px;
                            width: 100%;
                            background: item.tier_str == "declaration" ? #064e3b : (item.tier_str == "usage" ? #0f2942 : #111111);

                            animate background {
                                duration: 150ms;
                                easing: ease-in-out;
                            }


                            HorizontalLayout {
                                padding-left: 6px;
                                padding-right: 6px;
                                spacing: 8px;

                                // Line Number Column
                                Text {
                                    text: item.line_number;
                                    font-size: 12px;
                                    font-family: "DejaVu Sans Mono";
                                    color: item.tier_str == "declaration" ? #34d399 : (item.tier_str == "usage" ? #38bdf8 : (item.tier_str == "normal" ? #9ca3af : #4b5563));
                                    width: 45px;
                                    horizontal-alignment: end;
                                    vertical-alignment: center;
                                }

                                // Line Content View Mode
                                if !item.is_editing : TouchArea {
                                    horizontal-stretch: 1;
                                    enabled: item.tier_str == "declaration" || item.tier_str == "usage";
                                    clicked => {
                                        if (item.tier_str == "declaration") {
                                            root.click_declaration_line(item.line_number);
                                        } else if (item.tier_str == "usage") {
                                            root.jump_to_line(item.line_number);
                                        }
                                    }

                                    Text {
                                        text: item.text;
                                        font-size: 12px;
                                        font-family: "DejaVu Sans Mono";
                                        font-weight: (item.tier_str == "declaration" || item.tier_str == "usage") ? 700 : 400;
                                        color: item.tier_str == "declaration" ? #a7f3d0 : (item.tier_str == "usage" ? #38bdf8 : (item.tier_str == "normal" ? #e5e7eb : #555555));
                                        horizontal-alignment: left;
                                        vertical-alignment: center;
                                    }
                                }

                                // Scoped Single-Line Declaration Edit Mode
                                if item.is_editing : FocusScope {
                                    horizontal-stretch: 1;

                                    key-pressed(event) => {
                                        if (event.text == "\u{1b}") {
                                            root.cancel_declaration_edit(item.line_number);
                                            return accept;
                                        }
                                        return reject;
                                    }

                                    HorizontalLayout {
                                        padding-left: 2px;
                                        padding-right: 8px;
                                        spacing: 8px;

                                        edit_box := LineEdit {
                                            text: item.text;
                                            font-size: 12px;
                                            font-family: "DejaVu Sans Mono";
                                            horizontal-stretch: 1;
                                            accepted => { root.save_declaration_edit(item.line_number, edit_box.text); }
                                        }

                                        Button {
                                            text: "✓";
                                            width: 26px;
                                            clicked => { root.save_declaration_edit(item.line_number, edit_box.text); }
                                        }

                                        Button {
                                            text: "✕";
                                            width: 26px;
                                            clicked => { root.cancel_declaration_edit(item.line_number); }
                                        }

                                        if item.has_error : Text {
                                            text: "⚠️ " + item.error_message;
                                            font-size: 11px;
                                            color: #f87171;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                    }
                                }
                            }
                        }

                        // Bottom Spacer
                        Rectangle {
                            height: (root.total_line_count - root.visible_start_index - root.source_lines.length) * 20px;
                        }
                    }
                }


            }
        }
    }
}
