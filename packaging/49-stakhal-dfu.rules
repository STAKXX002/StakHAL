# STMicroelectronics STM32 DFU Bootloader (e.g. STM32F411CEU6 Black Pill)
# Allows unprivileged user access to the USB DFU bootloader (0483:df11)
SUBSYSTEM=="usb", ATTRS{idVendor}=="0483", ATTRS{idProduct}=="df11", MODE="0666", TAG+="uaccess"
SUBSYSTEMS=="usb", ATTRS{idVendor}=="0483", ATTRS{idProduct}=="df11", MODE:="0666", TAG+="uaccess"
